# Copy to .env and fill in. Never commit .env.

# Claude API key (or leave unset if you've run `ant auth login`)
ANTHROPIC_API_KEY=
# Required if your key is identity-linked: the workspace id (wrkspc_...) from
# https://console.anthropic.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=

# SMTP — for Gmail, create an app password at https://myaccount.google.com/apppasswords
# (requires 2FA on your Google account; your normal password will NOT work)
SMTP_USER=@gmail.com
SMTP_PASSWORD=
FROM_NAME=

# Only change these if you're not using Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Resend — only for emails_resend.py. Key from https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified at https://resend.com/domains, e.g. "Pradhi <pradhi@yourdomain.com>"
RESEND_FROM=
# Optional: where replies land (e.g. your Gmail)
RESEND_REPLY_TO=
